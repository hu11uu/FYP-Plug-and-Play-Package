# Copy to azure.env and fill in your own values. Never commit azure.env.
# Read by the Gradio, Telegram and Moodle hosts and measure_latency.py when run
# with --model azure. hosts/http_server.py reads these from the environment instead.

FYP_AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
FYP_AZURE_DEPLOYMENT=your-chat-deployment-name
FYP_AZURE_API_VERSION=2024-08-01-preview
FYP_AZURE_API_KEY=
