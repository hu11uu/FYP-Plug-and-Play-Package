# Copy to moodle.env and fill in your own value. Never commit moodle.env.
#
# Moodle does not issue this key. Make up a long random string, for example with
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# and enter the same value as the API key in local_ai_manager's connector, so
# only your Moodle site can call this server.

MOODLE_BACKEND_API_KEY=
